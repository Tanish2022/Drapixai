# Review candidate only. Never used by the production Dockerfiles by default.
FROM debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f AS build

RUN test "$(dpkg --print-architecture)" = amd64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl xz-utils python3 make g++ pkg-config libssl-dev \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libssl3t64)" ge '3.5.7-1~deb13u3' \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error \
      https://nodejs.org/download/release/v22.23.3/node-v22.23.3.tar.xz -o node.tar.xz \
    && echo 'bd97093e1a1e9243338950c174a693a64d4e0926a9c6ce259962bc58d5e96909  node.tar.xz' | sha256sum --check --strict \
    && tar -xJf node.tar.xz \
    && rm node.tar.xz

WORKDIR /build/node-v22.23.3
RUN ./configure --prefix=/opt/drapixai-node --shared-openssl --with-intl=full-icu \
    && make -j2 \
    && make install \
    && /opt/drapixai-node/bin/node -e "const a=require('node:assert/strict');a.equal(process.versions.node,'22.23.3');a.equal(process.versions.modules,'127');a.equal(process.config.variables.node_shared_openssl,true);a.ok(process.report.getReport().sharedObjects.some(p=>/libssl\\.so\\.3/.test(p)));a.ok(process.report.getReport().sharedObjects.some(p=>/libcrypto\\.so\\.3/.test(p)));"

COPY record-build.py /record-build.py
RUN python3 /record-build.py \
    && mkdir -p /var/lib/dpkg/status.d \
    && dpkg-query --status libssl3t64 > /var/lib/dpkg/status.d/libssl3t64 \
    && cp /var/lib/dpkg/info/libssl3t64:amd64.md5sums /var/lib/dpkg/status.d/libssl3t64.md5sums

FROM gcr.io/distroless/nodejs22-debian13:nonroot@sha256:ec2313763dd43931543bd03830466e0c409ce73a487e8d46f10db72d3b816c1c AS runtime
COPY --from=build /opt/drapixai-node/bin/node /nodejs/bin/node
COPY --from=build /usr/lib/x86_64-linux-gnu/libcrypto.so.3 /usr/lib/x86_64-linux-gnu/libcrypto.so.3
COPY --from=build /usr/lib/x86_64-linux-gnu/libssl.so.3 /usr/lib/x86_64-linux-gnu/libssl.so.3
COPY --from=build /usr/lib/x86_64-linux-gnu/engines-3 /usr/lib/x86_64-linux-gnu/engines-3
COPY --from=build /usr/lib/x86_64-linux-gnu/ossl-modules /usr/lib/x86_64-linux-gnu/ossl-modules
COPY --from=build /var/lib/dpkg/status.d/libssl3t64 /var/lib/dpkg/status.d/libssl3t64
COPY --from=build /var/lib/dpkg/status.d/libssl3t64.md5sums /var/lib/dpkg/status.d/libssl3t64.md5sums
COPY --from=build /opt/drapixai-node/build-provenance.json /usr/share/drapixai/node-build-provenance.json
COPY --from=build /build/node-v22.23.3/LICENSE /usr/share/drapixai/Node.LICENSE
COPY --from=build /usr/share/doc/libssl3t64/copyright /usr/share/drapixai/OpenSSL.copyright
COPY --from=build /usr/share/common-licenses/Apache-2.0 /usr/share/drapixai/Apache-2.0
LABEL io.drapixai.node-channel="shared-openssl-review-candidate"
USER nonroot
ENTRYPOINT ["/nodejs/bin/node"]
