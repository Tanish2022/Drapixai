NODE_ENV=production
PORT=8000
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/drapixai?sslmode=verify-full
REDIS_URL=rediss://USERNAME:PASSWORD@HOST:6379
DRAPIXAI_REDIS_PASSWORD=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-secret
DRAPIXAI_AUTH_SYNC_TOKEN=replace-with-the-same-web-api-auth-sync-token
DRAPIXAI_DASHBOARD_PROXY_TOKEN=replace-with-the-same-dashboard-proxy-token
DRAPIXAI_AI_URL=https://ai.drapixai.com
DRAPIXAI_AI_SERVICE_TOKEN=replace-with-a-long-random-secret
DRAPIXAI_CORS_ORIGINS=https://drapixai.com,https://www.drapixai.com
DRAPIXAI_CORS_CACHE_TTL_MS=30000
DRAPIXAI_TRUST_PROXY=1
DRAPIXAI_PUBLIC_API_BASE_URL=https://api.drapixai.com
DRAPIXAI_WEB_BASE_URL=https://drapixai.com
DRAPIXAI_MAX_UPLOAD_BYTES=10485760
DRAPIXAI_MAX_IMAGE_PIXELS=40000000
DRAPIXAI_MAX_IMAGE_DIMENSION=10000
DRAPIXAI_REQUIRE_GARMENT_CACHE=1
DRAPIXAI_ALLOW_SDK_DOMAIN_AUTO_BIND=0
DRAPIXAI_ALLOW_LEGACY_API_KEYS=0
DRAPIXAI_ENABLE_LEGACY_ASYNC_RENDER=0
DRAPIXAI_ALLOW_LOCAL_STORAGE_FALLBACK=0
DRAPIXAI_SDK_PREFER_ORIGINAL_GARMENT_FOR_TRYON=0
DRAPIXAI_SDK_GENERATION_SOURCE=original_verified
DRAPIXAI_GARMENT_APPROVAL_REQUIRED=1
DRAPIXAI_EXCELLENT_QUALITY_SCORE=0.95
DRAPIXAI_MIN_PUBLISHABLE_QUALITY_SCORE=0.95
DRAPIXAI_EXCELLENT_LATENCY_MS=10000
DRAPIXAI_MAX_PUBLISHABLE_LATENCY_MS=12000
DRAPIXAI_ENABLE_LOWER_BODY=0
DRAPIXAI_LOWER_BODY_ALLOWED_CATEGORIES=jeans,pants,trousers,shorts,skirt,leggings,joggers
DRAPIXAI_LOWER_BODY_ADMIN_REVIEW_REQUIRED=1
DRAPIXAI_LOWER_BODY_CACHE_VERSION=lower-v1-1024x1365
DRAPIXAI_ADMIN_TOKEN=replace-with-a-long-random-secret
DRAPIXAI_ADMIN_EMAIL=admin@drapixai.com
DRAPIXAI_ADMIN_PASSWORD=replace-with-a-strong-admin-password
DRAPIXAI_ADMIN_TOTP_SECRET=replace-with-base32-authenticator-secret
DRAPIXAI_ADMIN_USER_ID=0
DRAPIXAI_SHOPIFY_ENABLED=0
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_products
SHOPIFY_USE_LEGACY_INSTALL_FLOW=0
DRAPIXAI_SHOPIFY_AUTO_PREPARE=1
DRAPIXAI_SHOPIFY_PREPARE_BATCH_SIZE=3
DRAPIXAI_SHOPIFY_PREPARE_MAX_ATTEMPTS=3
DRAPIXAI_SHOPIFY_IMAGE_MAX_BYTES=10485760
DRAPIXAI_SHOPIFY_IMAGE_MAX_PIXELS=40000000
DRAPIXAI_SHOPIFY_IMAGE_HOSTS=cdn.shopify.com,*.shopifycdn.com
DRAPIXAI_SHOPIFY_STATE_SECRET=replace-with-a-long-random-secret
DRAPIXAI_SHOPIFY_TOKEN_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
DRAPIXAI_STOREFRONT_TOKEN_SECRET=replace-with-a-different-long-random-secret
DRAPIXAI_AUDIT_LOG_SECRET=replace-with-an-independent-long-random-secret
DRAPIXAI_REVIEW_RETENTION_DAYS=30
DRAPIXAI_REVIEW_RETENTION_BATCH_SIZE=200
DRAPIXAI_ENTERPRISE_QUOTA=100000
BILLING_UPGRADE_URL=https://drapixai.com/pricing
S3_BUCKET=drapixai-prod
AWS_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DRAPIXAI_S3_SERVER_SIDE_ENCRYPTION=aws:kms
DRAPIXAI_S3_KMS_KEY_ID=replace-with-kms-key-id
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@drapixai.com
