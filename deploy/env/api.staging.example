NODE_ENV=production
PORT=8000
DRAPIXAI_API_ENVIRONMENT=sandbox
DRAPIXAI_SECRETS_PROVIDER=mounted-file
DRAPIXAI_MOUNTED_SECRET_FILE=/run/secrets/drapixai-api
# Transactional sending only. Supply the separate staging SMTP_PASS through
# the mounted secret record; never paste it into this example or reuse outreach keys.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=resend
SMTP_FROM="DrapixAI Staging <no-reply-staging@mail.drapixai.com>"
SMTP_REPLY_TO=support@drapixai.com
EMAIL_SUPPORT_ADDRESS=support@drapixai.com
# Separate callback/HMAC secrets and sender identity; do not reuse production.
DRAPIXAI_EMAIL_EVENTS_ENABLED=0
DRAPIXAI_EMAIL_EVENT_SENDERS=no-reply-staging@mail.drapixai.com
DRAPIXAI_RESEND_WEBHOOK_SECRET=
DRAPIXAI_RESEND_WEBHOOK_PREVIOUS_SECRETS=
DRAPIXAI_EMAIL_RECIPIENT_HASH_SECRET=
DRAPIXAI_EMAIL_RECIPIENT_HASH_PREVIOUS_SECRETS=
DRAPIXAI_AWS_SECRET_ID=drapixai/staging/api
DRAPIXAI_PUBLIC_API_BASE_URL=https://api.staging.drapixai.com
DRAPIXAI_WEB_BASE_URL=https://staging.drapixai.com
DRAPIXAI_STRIPE_BILLING_ENABLED=1
DRAPIXAI_STRIPE_LIVE_MODE=0
DRAPIXAI_STRIPE_CURRENCY=usd
# Test-mode DRAPIXAI_STRIPE_SECRET_KEY and DRAPIXAI_STRIPE_WEBHOOK_SECRET are loaded from the mounted secret file.
DRAPIXAI_STRIPE_PRICE_STARTER=replace-with-stripe-test-starter-price-id
DRAPIXAI_STRIPE_PRICE_GROWTH=replace-with-stripe-test-growth-price-id
DRAPIXAI_STRIPE_PRICE_PRO=replace-with-stripe-test-pro-price-id
DRAPIXAI_CORS_ORIGINS=https://staging.drapixai.com
DRAPIXAI_TRUST_PROXY=1
DRAPIXAI_AI_URL=https://drapixai-ai.staging.internal
DRAPIXAI_AI_ALLOWED_HOSTS=drapixai-ai.staging.internal
DRAPIXAI_AI_PRIVATE_NETWORK=1
DRAPIXAI_AI_MTLS_ENABLED=1
DRAPIXAI_AI_MTLS_CERT_FILE=/run/secrets/drapixai-ai-client.crt
DRAPIXAI_AI_MTLS_KEY_FILE=/run/secrets/drapixai-ai-client.key
NODE_EXTRA_CA_CERTS=/run/secrets/drapixai-internal-ca.pem
S3_BUCKET=drapixai-staging
AWS_REGION=ap-south-1
# Use the staging AWS S3 endpoint and its VPC endpoint policy; do not set a local S3-compatible endpoint.
S3_FORCE_PATH_STYLE=0
DRAPIXAI_S3_SERVER_SIDE_ENCRYPTION=AES256
DRAPIXAI_ALLOW_LOCAL_STORAGE_FALLBACK=0
DRAPIXAI_REQUIRE_GARMENT_CACHE=1
DRAPIXAI_SDK_GENERATION_SOURCE=original_verified
DRAPIXAI_GARMENT_APPROVAL_REQUIRED=1
DRAPIXAI_ALLOW_SDK_DOMAIN_AUTO_BIND=0
DRAPIXAI_ALLOW_LEGACY_API_KEYS=0
DRAPIXAI_ENABLE_LEGACY_ASYNC_RENDER=0
DRAPIXAI_ENABLE_LOWER_BODY=0
DRAPIXAI_EXCELLENT_QUALITY_SCORE=0.95
DRAPIXAI_MIN_PUBLISHABLE_QUALITY_SCORE=0.95
DRAPIXAI_MAX_PUBLISHABLE_LATENCY_MS=12000
DRAPIXAI_SERVER_KEY_RATE_LIMIT=60
DRAPIXAI_API_KEY_RATE_LIMIT=300
DRAPIXAI_TENANT_RATE_LIMIT=600
DRAPIXAI_MAX_CONCURRENT_TRYONS=3
DRAPIXAI_TENANT_MAX_CONCURRENT_TRYONS=1
DRAPIXAI_TRYON_SLOT_LEASE_MS=120000
DRAPIXAI_TRYON_RESERVATION_MAX_MS=420000
DRAPIXAI_TRYON_ADMISSION_EPOCH=replace-with-distinct-staging-uuid
DRAPIXAI_AI_REQUEST_TIMEOUT_MS=360000
DRAPIXAI_AI_MAX_RESPONSE_BYTES=67108864
DRAPIXAI_TRYON_INTAKE_ENABLED=1
DRAPIXAI_REVIEW_RETENTION_DAYS=0
DRAPIXAI_REVIEW_RETENTION_BATCH_SIZE=100
DRAPIXAI_SHOPIFY_ENABLED=0
