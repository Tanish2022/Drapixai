# DrapixAI upper-body public-launch release profile.
# This file contains no secrets. Production secrets must be injected separately.
DRAPIXAI_RELEASE_PROFILE=standard-catvton-rc1
DRAPIXAI_QUALITY_MODE=standard
DRAPIXAI_TRYON_ENGINE=catvton
DRAPIXAI_WORKER_ROLE=upper
DRAPIXAI_ENABLE_LOWER_BODY=0

# Reproducible model sources.
DRAPIXAI_CATVTON_REPO_ID=zhengchong/CatVTON
DRAPIXAI_CATVTON_GIT_BRANCH=edited
DRAPIXAI_CATVTON_GIT_COMMIT=7818397f25613beedb3d861a34769f607cfcf3b1
DRAPIXAI_CATVTON_MODEL_REVISION=2969fcf85fe62f2036605716f0b56f0b81d01d79
DRAPIXAI_CATVTON_BASE_REPO_ID=runwayml/stable-diffusion-inpainting
DRAPIXAI_CATVTON_BASE_REVISION=8a4288a76071f7280aedbdb3253bdb9e9d5d84bb
DRAPIXAI_CATVTON_VAE_REPO_ID=stabilityai/sd-vae-ft-mse
DRAPIXAI_CATVTON_VAE_REVISION=31f26fdeee1355a5c34592e401dd41e45d25a493

# Standard generation is intentionally one output. These values may change only
# through a new baseline, visual review, and release profile version.
DRAPIXAI_CANDIDATE_COUNT=1
DRAPIXAI_INFERENCE_STEPS=22
DRAPIXAI_GUIDANCE_SCALE=2.5
DRAPIXAI_CATVTON_WIDTH=768
DRAPIXAI_CATVTON_HEIGHT=1024
DRAPIXAI_CATVTON_MASK_SOURCE=automasker
DRAPIXAI_CATVTON_MASK_BLUR=9
DRAPIXAI_CATVTON_SKIP_SAFETY_CHECK=0

# Approved quality-preservation controls.
DRAPIXAI_MIN_QUALITY_SCORE=0.95
DRAPIXAI_ENABLE_GARMENT_COLOR_FIX=1
DRAPIXAI_GARMENT_COLOR_FIX_STRENGTH=0.94
DRAPIXAI_GARMENT_COLOR_FIX_EDGE_GUARD=1
DRAPIXAI_ENABLE_NATURAL_LIGHTING_FIX=1
DRAPIXAI_NATURAL_LIGHTING_STRENGTH=0.55
DRAPIXAI_ENABLE_FASHION_POLISH=1
DRAPIXAI_FASHION_POLISH_STRENGTH=0.45
DRAPIXAI_ENABLE_REFINEMENT=0
DRAPIXAI_ENABLE_UPSCALE=0

# Garment cache and shopper output contract.
DRAPIXAI_GARMENT_CACHE_VERSION=v3-1024x1365
DRAPIXAI_GARMENT_TARGET_WIDTH=1024
DRAPIXAI_GARMENT_TARGET_HEIGHT=1365
DRAPIXAI_ENABLE_FINAL_OUTPUT_UPSCALE=1
DRAPIXAI_OUTPUT_WIDTH=1024
DRAPIXAI_OUTPUT_HEIGHT=1365
DRAPIXAI_OUTPUT_FORMAT=png

# The single-request baseline remains the rollback mode. Three-user adaptive
# batching is a later launch gate and must not alter this release baseline.
DRAPIXAI_ADAPTIVE_BATCHING=0
DRAPIXAI_GPU_BATCH_MAX=3
DRAPIXAI_TARGET_TRYON_MS=12000
