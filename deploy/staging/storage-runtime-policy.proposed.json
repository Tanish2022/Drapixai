{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyS3OutsideTheStagingBucket",
      "Effect": "Deny",
      "Action": "s3:*",
      "NotResource": [
        "arn:aws:s3:::drapixai-cpu-staging-111122223333-ap-south-1",
        "arn:aws:s3:::drapixai-cpu-staging-111122223333-ap-south-1/*"
      ]
    },
    {
      "Sid": "ReadStagingBucketMetadata",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:GetBucketVersioning"],
      "Resource": "arn:aws:s3:::drapixai-cpu-staging-111122223333-ap-south-1"
    },
    {
      "Sid": "ListOnlyApplicationAndVerificationPrefixes",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions"],
      "Resource": "arn:aws:s3:::drapixai-cpu-staging-111122223333-ap-south-1",
      "Condition": {
        "StringLike": {"s3:prefix": ["garments/*", "tryon-review/*", "staging-verification/*"]}
      }
    },
    {
      "Sid": "ReadAndEraseOnlyApplicationAndVerificationObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": [
        "arn:aws:s3:::drapixai-cpu-staging-111122223333-ap-south-1/garments/*",
        "arn:aws:s3:::drapixai-cpu-staging-111122223333-ap-south-1/tryon-review/*",
        "arn:aws:s3:::drapixai-cpu-staging-111122223333-ap-south-1/staging-verification/*"
      ]
    },
    {
      "Sid": "WriteOnlyEncryptedApplicationAndVerificationObjects",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::drapixai-cpu-staging-111122223333-ap-south-1/garments/*",
        "arn:aws:s3:::drapixai-cpu-staging-111122223333-ap-south-1/tryon-review/*",
        "arn:aws:s3:::drapixai-cpu-staging-111122223333-ap-south-1/staging-verification/*"
      ],
      "Condition": {"StringEquals": {"s3:x-amz-server-side-encryption": "AES256"}}
    }
  ]
}
