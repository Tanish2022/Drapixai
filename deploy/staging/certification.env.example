# Copy outside the repository, replace every placeholder from the staging secret store,
# and keep the resulting file mode 0600. Tokens must never be added to the manifest.
DRAPIXAI_STAGING_CERTIFICATION_ENVIRONMENT=staging
DRAPIXAI_STAGING_CERTIFICATION_API_URL=https://api.staging.example.com
DRAPIXAI_EXPECTED_GIT_REF=REPLACE_WITH_40_CHARACTER_RELEASE_COMMIT
DRAPIXAI_THREE_TENANT_MANIFEST=/run/secrets/drapixai-three-tenant-manifest.json

# Dedicated disposable staging accounts, products, result, and credentials.
DRAPIXAI_SECURITY_TEST_API_URL=https://api.staging.example.com
DRAPIXAI_SECURITY_TEST_SERVER_KEY_A=REPLACE_WITH_STAGING_SERVER_KEY
DRAPIXAI_SECURITY_TEST_SHOPPER_TOKEN_A=REPLACE_WITH_SHORT_LIVED_STAGING_SHOPPER_TOKEN
DRAPIXAI_SECURITY_TEST_EXPIRED_SHOPPER_TOKEN_A=REPLACE_WITH_EXPIRED_STAGING_SHOPPER_TOKEN
DRAPIXAI_SECURITY_TEST_PRODUCT_A=REPLACE_WITH_TENANT_A_PRODUCT_ID
DRAPIXAI_SECURITY_TEST_PRODUCT_B=REPLACE_WITH_TENANT_B_PRODUCT_ID
DRAPIXAI_SECURITY_TEST_RESULT_B=REPLACE_WITH_TENANT_B_RESULT_ID
DRAPIXAI_SECURITY_TEST_ORIGIN_A=https://tenant-a-staging.example.com
DRAPIXAI_SECURITY_TEST_PUBLIC_API_TOKEN_A=REPLACE_WITH_STAGING_API_USAGE_AND_WEBHOOK_TOKEN
DRAPIXAI_SECURITY_TEST_RATE_LIMIT_PATH=/v1/usage
DRAPIXAI_SECURITY_TEST_RATE_LIMIT_ATTEMPTS=21
DRAPIXAI_SECURITY_TEST_ENVIRONMENT=staging
