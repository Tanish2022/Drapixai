# Copy to /etc/drapixai/internal-proxy.env (mode 0600). Do not commit the copy.
# This is the GPU workstation VPN address, never its public LAN/WAN address.
DRAPIXAI_VPN_BIND_IP=100.64.0.10
DRAPIXAI_AI_INTERNAL_HOST=ai.drapixai.internal
DRAPIXAI_INTERNAL_PROXY_PORT=443
DRAPIXAI_AI_LOCAL_PORT=8080
DRAPIXAI_MTLS_SERVER_CERT=/etc/drapixai/internal-proxy/server.crt
DRAPIXAI_MTLS_SERVER_KEY=/etc/drapixai/internal-proxy/server.key
DRAPIXAI_MTLS_CLIENT_CA=/etc/drapixai/internal-proxy/api-client-ca.crt
