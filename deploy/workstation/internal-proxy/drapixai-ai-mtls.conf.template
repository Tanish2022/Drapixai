# Render this template with deploy/workstation/internal-proxy/render-config.sh.
# Nginx must bind only to the VPN address, never 0.0.0.0 or [::].

server {
    listen ${DRAPIXAI_VPN_BIND_IP}:${DRAPIXAI_INTERNAL_PROXY_PORT} ssl http2;
    server_name ${DRAPIXAI_AI_INTERNAL_HOST};

    server_tokens off;
    client_max_body_size 20m;
    client_body_timeout 30s;
    client_header_timeout 15s;
    keepalive_timeout 30s;

    ssl_certificate ${DRAPIXAI_MTLS_SERVER_CERT};
    ssl_certificate_key ${DRAPIXAI_MTLS_SERVER_KEY};
    ssl_client_certificate ${DRAPIXAI_MTLS_CLIENT_CA};
    ssl_verify_client on;
    ssl_verify_depth 2;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    ssl_session_cache shared:DRAPIXAI_INTERNAL_TLS:1m;

    location / {
        proxy_pass http://127.0.0.1:${DRAPIXAI_AI_LOCAL_PORT};
        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        proxy_read_timeout 360s;
        proxy_send_timeout 360s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
    }
}
