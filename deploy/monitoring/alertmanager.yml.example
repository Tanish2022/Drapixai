route:
  receiver: operations-oncall
  group_by:
    - alertname
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 2h
  routes:
    - matchers:
        - severity="critical"
      receiver: security-pager
      repeat_interval: 15m

receivers:
  - name: operations-oncall
    webhook_configs:
      - url_file: /run/secrets/drapixai-operations-alert-webhook
        send_resolved: true

  - name: security-pager
    webhook_configs:
      - url_file: /run/secrets/drapixai-security-pager-webhook
        send_resolved: true
