{
  "name": "drapixai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "docker-compose up -d",
    "dev:api": "cd apps\\api && npm run dev",
    "dev:web": "cd apps\\web && npm run dev",
    "dev:worker": "cd workers\\gpu-worker && python src\\worker.py",
    "stop": "docker-compose down",
    "build": "npm --prefix apps/api run build && npm --prefix apps/web run build",
    "preflight:local": "powershell -ExecutionPolicy Bypass -File deploy\\scripts\\local-preflight.ps1",
    "prove:live": "powershell -ExecutionPolicy Bypass -File deploy\\scripts\\prove-live-stack.ps1",
    "test:launch": "npm --prefix apps/api run test:launch"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
