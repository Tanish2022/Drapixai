{
  "name": "drapixai",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "docker-compose up -d",
    "dev:api": "cd apps\\api && npm run dev",
    "dev:web": "cd apps\\web && npm run dev",
    "dev:worker": "cd workers\\gpu-worker && python src\\worker.py",
    "stop": "docker-compose down",
    "start:local": "powershell -ExecutionPolicy Bypass -File deploy\\scripts\\start-local-stack.ps1",
    "build": "npm --prefix apps/api run build && npm --prefix apps/web run build",
    "preflight:local": "powershell -ExecutionPolicy Bypass -File deploy\\scripts\\local-preflight.ps1",
    "prove:live": "powershell -ExecutionPolicy Bypass -File deploy\\scripts\\prove-live-stack.ps1",
    "launch:report": "node scripts/launch-gate-report.mjs --scope=all",
    "launch:report:repository": "node scripts/launch-gate-report.mjs --scope=repository",
    "launch:evidence:init": "node scripts/init-launch-evidence.mjs",
    "launch:certify:disposable-db": "node scripts/certify-disposable-db.mjs",
    "test:launch": "npm --prefix apps/api run test:launch",
    "test:shopify": "npm --prefix apps/api run test:shopify",
    "test:storefront-key-lifecycle": "npm --prefix apps/api run test:storefront-key-lifecycle"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
