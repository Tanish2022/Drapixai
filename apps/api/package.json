{
  "name": "drapixai-api",
  "version": "1.0.0",
  "engines": {
    "node": ">=22 <25"
  },
  "main": "dist/bootstrap.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/bootstrap.ts",
    "build": "tsc",
    "start": "node dist/bootstrap.js",
    "garments:regenerate-cache": "ts-node src/scripts/regenerate-garment-caches.ts",
    "garments:regenerate-cache:dist": "npm run build && node dist/scripts/regenerate-garment-caches.js",
    "tryon:purge-review-retention": "ts-node src/scripts/purge-tryon-review-retention.ts",
    "privacy:verify-shopper-media": "ts-node src/scripts/verify-shopper-media-privacy.ts",
    "privacy:purge-legacy-media": "ts-node src/scripts/purge-legacy-render-media.ts",
    "tryon:purge-review-retention:dist": "npm run build && node dist/scripts/purge-tryon-review-retention.js",
    "email:send-test": "ts-node src/scripts/send-test-email.ts",
    "email:send-test:dist": "npm run build && node dist/scripts/send-test-email.js",
    "test:launch": "ts-node src/scripts/launch-readiness-tests.ts",
    "test:shopify": "ts-node src/scripts/shopify-foundation-tests.ts",
    "test:storefront-key-lifecycle": "ts-node src/scripts/storefront-key-lifecycle-smoke.ts",
    "test:authorization": "ts-node src/scripts/authorization-tests.ts",
    "test:storefront-tokens": "ts-node src/scripts/storefront-token-tests.ts",
    "test:audit-immutability": "ts-node src/scripts/verify-audit-immutability.ts",
    "test:cors-origin-cache": "ts-node src/scripts/cors-origin-cache-tests.ts",
    "test:image-upload-security": "ts-node src/scripts/image-upload-security-tests.ts",
    "test:async-errors": "ts-node src/scripts/express-async-error-tests.ts",
    "test:public-api": "ts-node src/scripts/public-api-v1-tests.ts",
    "test:distributed-security": "ts-node src/scripts/distributed-security-control-tests.ts",
    "test:log-privacy": "ts-node src/scripts/log-privacy-tests.ts",
    "test:admin-mfa": "ts-node src/scripts/admin-mfa-tests.ts",
    "test:tryon-intake": "ts-node src/scripts/tryon-intake-tests.ts",
    "test:input-validation": "ts-node src/scripts/input-validation-tests.ts",
    "security:audit:verify": "ts-node src/scripts/verify-security-audit.ts",
    "security:webhooks:rotate-key": "ts-node src/scripts/rotate-webhook-encryption.ts",
    "test:security:live": "ts-node src/scripts/live-security-boundary-tests.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-secrets-manager": "3.1097.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.0.0",
    "drapixai": "file:../..",
    "express": "5.2.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "2.2.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "redis": "^4.6.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.0",
    "@types/cors": "^2.8.0",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^1.4.0",
    "@types/node": "^20.0.0",
    "nodemon": "^3.0.0",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}
