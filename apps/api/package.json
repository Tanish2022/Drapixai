{
  "name": "drapixai-api",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "garments:regenerate-cache": "ts-node src/scripts/regenerate-garment-caches.ts",
    "garments:regenerate-cache:dist": "npm run build && node dist/scripts/regenerate-garment-caches.js",
    "tryon:purge-review-retention": "ts-node src/scripts/purge-tryon-review-retention.ts",
    "tryon:purge-review-retention:dist": "npm run build && node dist/scripts/purge-tryon-review-retention.js",
    "email:send-test": "ts-node src/scripts/send-test-email.ts",
    "email:send-test:dist": "npm run build && node dist/scripts/send-test-email.js",
    "test:launch": "ts-node src/scripts/launch-readiness-tests.ts",
    "test:shopify": "ts-node src/scripts/shopify-foundation-tests.ts",
    "test:storefront-key-lifecycle": "ts-node src/scripts/storefront-key-lifecycle-smoke.ts",
    "test:authorization": "ts-node src/scripts/authorization-tests.ts",
    "test:storefront-tokens": "ts-node src/scripts/storefront-token-tests.ts",
    "test:audit-immutability": "ts-node src/scripts/verify-audit-immutability.ts",
    "test:cors-origin-cache": "ts-node src/scripts/cors-origin-cache-tests.ts",
    "test:image-upload-security": "ts-node src/scripts/image-upload-security-tests.ts",
    "security:audit:verify": "ts-node src/scripts/verify-security-audit.ts",
    "test:security:live": "ts-node src/scripts/live-security-boundary-tests.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.0.0",
    "drapixai": "file:../..",
    "express": "^4.22.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "redis": "^4.6.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^1.4.0",
    "@types/node": "^20.0.0",
    "nodemon": "^3.0.0",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
